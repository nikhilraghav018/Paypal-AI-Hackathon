# Copy this file to .env.local. Every value is optional: anything left blank runs in labelled demo mode.

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox.
# The app only ever calls PayPal's sandbox host, so it cannot move real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the ID shown after adding a webhook in your sandbox app. Events are refused without it.
PAYPAL_WEBHOOK_ID=

# Free Gemini key from Google AI Studio. Use a project with no billing account linked.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Channel3 key from trychannel3.com/developers. No card needed; promo code PAYPAL-HACKATHON-2026.
CHANNEL3_API_KEY=

# Long random string so approvals survive a server restart.
MANDATE_SECRET=

# Public URL when hosted. Leave blank locally.
# APP_URL=

# Lets outside AI agents (Claude, ChatGPT and other MCP clients) ask Velora to buy things at /api/mcp.
# Use a long random secret, for example from: openssl rand -hex 32. Leave blank to keep MCP off.
# When it is on, each visitor copies their own agent key from Live services > Connect an AI agent.
VELORA_MCP_TOKEN=
